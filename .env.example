# Copy to .env and fill in. Earth Engine requires a Google Cloud project ID.
# Create a project in Google Cloud Console, enable Earth Engine API, register it
# in the Earth Engine Code Editor, then set:
GEE_PROJECT_ID=your-gcp-project-id

# Optional: AWS credentials for downloading SatPM V6 NetCDF from Open Data on AWS
# (requester pays). Needed for full 2015–2023 monthly merge without manual files.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-west-2
